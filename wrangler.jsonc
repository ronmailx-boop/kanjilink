// Cloudflare Workers: serves the Kanjilink website (privacy policy, terms) as static assets (no Worker script).
{
  "name": "kanjilink",
  "compatibility_date": "2026-11-23",
  "assets": { "directory": "site" },
  "workers_dev": true,
  "routes": [{ "pattern": "kanjilink.vplusstudio.app", "custom_domain": true }]
}
